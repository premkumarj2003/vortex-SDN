# VORTEX-SDN Environment Configuration Template
# Copy this file to .env and insert your real Gmail App Password & configuration.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
APP_BASE_URL=http://127.0.0.1:5000
SECRET_KEY=vortex-security-secret-key-2026

# Optional Configuration:
SMTP_USE_TLS=true
VERIFICATION_TOKEN_EXPIRY_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30
